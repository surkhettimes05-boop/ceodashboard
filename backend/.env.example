# Backend environment variables
# Copy this file to .env and replace all placeholders with environment-specific values.

PORT=3001
NODE_ENV=development
# Production DATABASE_URL must target the ceo logical database on the shared PostgreSQL server.
# This localhost connection is for development only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ceodashboard?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret-at-least-32-characters"
FEEDBACK_TOKEN_SECRET="replace-with-a-different-long-random-feedback-token-secret"
# Production required: this must equal PASALO STORE_SYNC_WEBHOOK_SECRET.
PASALO_WEBHOOK_SECRET="replace-with-a-long-random-pasalo-webhook-secret"
# The same secret authenticates PASALO online fulfillment reserve/complete/cancel callbacks.
# PASALO.OS machine endpoint. The transfer id is appended to this URL.
PASALO_RECEIPT_ACK_URL="https://pasalo.example.com/api/v1/integrations/store-receipts"
# Comma-separated CEO branch codes that PASALO is permitted to synchronize.
PASALO_ALLOWED_BRANCH_CODES="STORE-001,STORE-002"
# PASALO public product catalog endpoint and read-only integration credential
PASALO_CATALOG_API_URL="https://pasalo.example.com/api/v1/catalog/products"
PASALO_CATALOG_API_KEY="replace-with-a-read-only-pasalo-catalog-key"
PASALHO_REPORTING_API_URL="https://pasalho.example.com"
PASALHO_REPORTING_API_TOKEN="replace-with-pasalho-reporting-api-token"
JWT_EXPIRES_IN="15m"
CORS_ORIGIN="https://your-frontend.vercel.app"

# Production bootstrap only
SEED_CEO_EMAIL="ceo@yourcompany.example"
SEED_CEO_PASSWORD="replace-with-a-strong-production-password"
SEED_DEMO_DATA="false"
