# Backend environment variables
# Copy this file to .env and replace all placeholders with environment-specific values.

PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ceodashboard?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret-at-least-32-characters"
FEEDBACK_TOKEN_SECRET="replace-with-a-different-long-random-feedback-token-secret"
JWT_EXPIRES_IN="15m"
CORS_ORIGIN="https://your-frontend.vercel.app"

# Production bootstrap only
SEED_CEO_EMAIL="ceo@yourcompany.example"
SEED_CEO_PASSWORD="replace-with-a-strong-production-password"
SEED_DEMO_DATA="false"
